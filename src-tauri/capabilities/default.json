{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main and host windows: core APIs, events between windows, opening the host window",
  "windows": [
    "main",
    "host-*"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus"
  ]
}
