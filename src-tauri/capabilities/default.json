{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "App windows: core APIs and events, opening the host window, placing the stage on a chosen monitor, native file dialogs, reading opened or picked game files, updates",
  "windows": [
    "main",
    "host-*",
    "screen-flash"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-set-fullscreen",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-close",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "updater:default",
    "process:allow-restart"
  ]
}
