{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "App windows: core APIs and events, opening the host window, native file dialogs, reading opened or picked game files, updates",
  "windows": [
    "main",
    "host-*"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "updater:default",
    "process:allow-restart"
  ]
}
